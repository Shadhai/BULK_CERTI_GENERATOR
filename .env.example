BCG_DATABASE_URL=postgresql+psycopg://bcg:bcg@localhost:5432/bcg
BCG_STORAGE_ROOT=./storage
BCG_WORKER_ENABLED=true
BCG_MAX_BATCH_SIZE=5000
BCG_BATCH_CHUNK_SIZE=50
BCG_WORKER_POLL_INTERVAL=1.0
BCG_STALE_JOB_TIMEOUT_SECONDS=600
BCG_API_KEY=
BCG_RETRY_AFTER_SECONDS=2
# .env  (the same file your local dev uses)
BCG_API_KEY=local-dev-secret